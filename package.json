{
  "name": "haunted-terminal",
  "version": "1.0.0",
  "description": "A ghost that haunts your terminal using open-source AI",
  "type": "module",
  "scripts": {
    "start": "tsx src/ghost.tsx",
    "daemon": "tsx src/daemon.ts",
    "build": "tsc",
    "dev": "tsx watch src/ghost.tsx",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "terminal",
    "ghost",
    "open-source",
    "ollama",
    "react",
    "ink"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "ink": "^4.4.1",
    "react": "^18.2.0",
    "node-pty": "^1.0.0",
    "ollama": "^0.5.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "rate-limiter-flexible": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}